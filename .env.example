# GEMINI_API_KEY: Optional if using AI capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# CLOUDINARY CONFIGURATION (Client-side safe delivery and unsigned upload)
# Set your Cloudinary cloud name and unsigned upload preset.
# DO NOT add or store API secrets.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# TURSO DATABASE CONFIGURATION
# Your Turso database URL (e.g., libsql://your-db-org.turso.io) and auth token
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
